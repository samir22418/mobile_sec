<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug only: cleartext is permitted for local backend endpoints.
    - 10.0.2.2   Android emulator → host machine
    - 10.0.3.2   Genymotion → host machine
    - 127.0.0.1  Loopback
    - localhost

    For a real device on LAN, also add the host machine's LAN IP here,
    or point AEGIS_BACKEND_URL at an HTTPS tunnel (e.g. ngrok, Tailscale).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
