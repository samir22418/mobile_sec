# Set to "dev" for local development — enables weak-token defaults and skips
# the console API-key requirement.  Never set to "dev" in staging or production.
AEGIS_ENV=dev

AEGIS_BACKEND_DATABASE_URL=sqlite:///../backend-data/aegis.db
AEGIS_RAW_PAYLOAD_DIR=../backend-data/raw-payloads

# Device enrollment token(s) — comma-separated.  Must be strong secrets in
# non-dev environments; "sample-token" is blocked outside AEGIS_ENV=dev.
AEGIS_ACCEPTED_ENROLLMENT_TOKENS=sample-token

# API key for analyst/console read endpoints (X-Aegis-Api-Key header).
# Required in non-dev environments.  Set a strong random value in production.
AEGIS_CONSOLE_API_KEY=dev-console-key

# true = ingest endpoint processes payloads synchronously (dev/test only).
# false (default) = processing is handled by the background worker.
AEGIS_PROCESS_INLINE=false

AEGIS_WORKER_POLL_INTERVAL_SECONDS=5

